# Lichess API token
LICHESS_TOKEN=seu_token_aqui

# Stockfish path (use the container default)
STOCKFISH_PATH=/usr/local/bin/stockfish

# Engine settings
ENGINE_IMPLEMENTATION=stockfish # Options: stockfish, random
ENGINE_SKILL_LEVEL=10
ENGINE_THREADS=2
ENGINE_TIME_LIMIT=2.0

# Challenge filters
ACCEPT_VARIANTS=standard
MIN_RATING=0
MAX_RATING=3000
ACCEPT_CASUAL=true
ACCEPT_RATED=true

# Logging
LOG_LEVEL=INFO