# Token da API do Lichess
LICHESS_TOKEN=seu_token_aqui

# Caminho do Stockfish (use o padrão do container)
STOCKFISH_PATH=/usr/local/bin/stockfish

# Configurações do Engine
ENGINE_SKILL_LEVEL=10
ENGINE_THREADS=2
ENGINE_TIME_LIMIT=2.0

# Filtros de desafio
ACCEPT_VARIANTS=standard
MIN_RATING=0
MAX_RATING=3000
ACCEPT_CASUAL=true
ACCEPT_RATED=true

# Logging
LOG_LEVEL=INFO
